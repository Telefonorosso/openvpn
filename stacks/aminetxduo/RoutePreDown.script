; AmiOpenVPN / AmiNetXDuo POC2 DNS TEST CANDIDATE
; Restore original DNS before reverting the IPv4 default route.
FailAt 21
Echo "[PRE-DOWN] Restoring original DNS first"
OPENVPN:anxdns DOWN
If WARN
  Echo "[PRE-DOWN] WARNING: DNS restore incomplete; inspect RAM:AOVPN-XD-DNS.state"
  Echo "[PRE-DOWN] Still attempting to restore physical routing"
EndIf
Echo "[PRE-DOWN] Restoring physical IPv4 route"
RX OPENVPN:AOVPN-Routes.rexx DOWN
If WARN
  Echo "[PRE-DOWN] Routing FAILED. Inspect RAM:AOVPN-XD-Routes.state"
  Quit 10
EndIf
Echo "[PRE-DOWN] Physical route restored (verify DNS warnings above)"
Quit 0
