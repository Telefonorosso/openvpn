.KEY dev,mtu,link_mtu,local,remote,context
; AmiOpenVPN / AmiNetXDuo POC1. Preserve configured peer in ptp0 file.
FailAt 21
Echo "[UP] Applying OpenVPN local IPv4 and MTU to ptp0"
C:ConfigureNetInterface ptp0 ADDRESS=<local> MTU=<mtu>
If WARN
  Echo "[UP] ptp0 configuration failed"
  Quit 10
EndIf
Echo "[UP] ptp0 ready"
Quit 0
