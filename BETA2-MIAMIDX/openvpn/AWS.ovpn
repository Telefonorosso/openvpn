client
dev tun
proto udp
remote blah.eu-west-3.compute.amazonaws.com 1194
ca OPENVPN:ca.crt
cert OPENVPN:amiga1.crt
key OPENVPN:amiga1.key
tls-crypt OPENVPN:tls-crypt.key
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA512
ignore-unknown-option block-outside-dns
ifconfig-noexec
route-noexec
tun-mtu 1400
pull-filter ignore "tun-mtu"
pull-filter ignore "block-outside-dns"
verb 3
tmp-dir T:
script-security 2
up OPENVPN:Up.script
route-up OPENVPN:RouteUp.script
route-pre-down OPENVPN:RoutePreDown.script
