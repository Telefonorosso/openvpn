; Start script and allow non-fatal command errors
Echo "[ROUTE-UP] BEGIN"
FailAt 21

; Ask for physical gateway only if automatic discovery failed
If "${route_net_gateway}" EQ ""
SetEnv route_net_gateway `OPENVPN:RequestString TITLE Warning BODY "Cannot determine default gateway, please enter one"`
EndIf

; Protect the OpenVPN server endpoint via physical gateway
Echo "[ROUTE-UP] Adding host route: ${trusted_ip} via ${route_net_gateway}"
MIAMI:MiamiRoute -n add -host ${trusted_ip} ${route_net_gateway}

; Route all IPv4 address space through the VPN
Echo "[ROUTE-UP] Adding 0.0.0.0/0 via ${route_vpn_gateway}"
MIAMI:MiamiRoute -n add -net 128.0.0.0 -netmask 128.0.0.0 ${route_vpn_gateway}
MIAMI:MiamiRoute -n add -net 0.0.0.0 -netmask 128.0.0.0 ${route_vpn_gateway}

; Extract pushed DNS address
Echo "[ROUTE-UP] Extracting DNS from ${foreign_option_1}"
rx "say word(arg(1),3)" ${foreign_option_1} >T:vpndns

; Install DNS leak protection rule
Echo "[ROUTE-UP] Installing MiamiIPFW DNS rule 60010"
MIAMI:MiamiIPFW add 60010 deny udp from any to not `Type T:vpndns` 53 out

; Write MiamiDX DNS database update
Echo "[ROUTE-UP] Writing DNS configuration to ENVARC:MiamiChangeDB"
Echo "ADD dns `Type T:vpndns` (ptp0)" >ENVARC:MiamiChangeDB

; Apply DNS database changes through ARexx
Echo "[ROUTE-UP] Applying MiamiDX CHANGEDB"
rx "address MIAMI.1;CHANGEDB"
Delete T:vpndns

Echo "[ROUTE-UP] END"
