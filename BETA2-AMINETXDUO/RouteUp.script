; AmiOpenVPN / AmiNetXDuo POC2 DNS TEST CANDIDATE
; Keep FIX1 routing. Capture OpenVPN's child Shell local values with Get.
; Files are regenerated every run. Missing foreign_options are harmless.
FailAt 21
Echo "[ROUTE-UP] Reading trusted_ip from OpenVPN hook environment"
Get trusted_ip >RAM:AOVPN-XD-TrustedIP.tmp
If WARN
  Echo "[ROUTE-UP] GET trusted_ip failed; no routes changed"
  Quit 10
EndIf
Echo "[ROUTE-UP] Saving physical route and switching IPv4 default"
RX OPENVPN:AOVPN-Routes.rexx UP
If WARN
  Echo "[ROUTE-UP] Routing FAILED; DNS untouched"
  Quit 10
EndIf
Echo "[ROUTE-UP] Capturing server-pushed DNS options"
Delete RAM:AOVPN-XD-DNS-opt#?.tmp QUIET
Get foreign_option_1 >RAM:AOVPN-XD-DNS-opt1.tmp
Get foreign_option_2 >RAM:AOVPN-XD-DNS-opt2.tmp
Get foreign_option_3 >RAM:AOVPN-XD-DNS-opt3.tmp
Get foreign_option_4 >RAM:AOVPN-XD-DNS-opt4.tmp
Get foreign_option_5 >RAM:AOVPN-XD-DNS-opt5.tmp
Get foreign_option_6 >RAM:AOVPN-XD-DNS-opt6.tmp
Get foreign_option_7 >RAM:AOVPN-XD-DNS-opt7.tmp
Get foreign_option_8 >RAM:AOVPN-XD-DNS-opt8.tmp
Get foreign_option_9 >RAM:AOVPN-XD-DNS-opt9.tmp
Get foreign_option_10 >RAM:AOVPN-XD-DNS-opt10.tmp
Get foreign_option_11 >RAM:AOVPN-XD-DNS-opt11.tmp
Get foreign_option_12 >RAM:AOVPN-XD-DNS-opt12.tmp
Echo "[ROUTE-UP] Applying VPN DNS through bsdsocket.library"
OPENVPN:anxdns UP
If WARN
  Echo "[ROUTE-UP] DNS FAILED; restoring physical routing"
  RX OPENVPN:AOVPN-Routes.rexx DOWN
  If WARN
    Echo "[ROUTE-UP] CRITICAL: physical routing restore failed"
    Echo "[ROUTE-UP] Inspect RAM:AOVPN-XD-Routes.state"
  EndIf
  Echo "[ROUTE-UP] Inspect RAM:AOVPN-XD-DNS.state and run OPENVPN:anxdns DOWN"
  Quit 10
EndIf
Delete RAM:AOVPN-XD-TrustedIP.tmp QUIET
Delete RAM:AOVPN-XD-DNS-opt#?.tmp QUIET
Echo "[ROUTE-UP] VPN IPv4 routing and DNS runtime active"
Quit 0
