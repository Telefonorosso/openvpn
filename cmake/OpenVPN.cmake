set(vfork fork)
# Reuse upstream's complete configuration template. Only the configure-time
# substitution syntax changes; feature probes are target compile/link checks.
file(READ "${OVPN}/config.h.in" template)
string(REGEX REPLACE "#undef ([A-Za-z0-9_]+)" "#cmakedefine \\1 @\\1@" template "${template}")
string(REGEX REPLACE "#cmakedefine (HAVE_DECL_[A-Z0-9_]+) @HAVE_DECL_[A-Z0-9_]+@" "#cmakedefine01 \\1" template "${template}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/config.h.cmake.in" "${template}")
configure_file("${CMAKE_CURRENT_BINARY_DIR}/config.h.cmake.in" "${CMAKE_CURRENT_BINARY_DIR}/config.h" @ONLY)

# The port's maintained Automake manifest is the source inventory, not a second
# manually copied list. Only the unconditional openvpn_SOURCES assignment is
# used; Windows resource additions are outside this section.
file(STRINGS "${OVPN}/src/openvpn/Makefile.am" lines)
set(collect OFF)
set(sources)
foreach(line IN LISTS lines)
  if(line MATCHES "^openvpn_SOURCES[ \t]*=")
    set(collect ON)
  elseif(line MATCHES "^openvpn_LDADD[ \t]*=")
    break()
  endif()
  if(collect)
    string(REGEX MATCHALL "[a-zA-Z0-9_-]+\\.c([ \t]|$)" files "${line}")
    foreach(file IN LISTS files)
      string(STRIP "${file}" file)
      list(APPEND sources "${OVPN}/src/openvpn/${file}")
    endforeach()
  endif()
endforeach()
if(NOT sources)
  message(FATAL_ERROR "The upstream OpenVPN source manifest could not be read")
endif()
add_library(openvpn_compat STATIC
  "${OVPN}/src/compat/compat-dirname.c" "${OVPN}/src/compat/compat-basename.c"
  "${OVPN}/src/compat/compat-gettimeofday.c" "${OVPN}/src/compat/amiga_gettimeofday.c"
  "${OVPN}/src/compat/amiga_timer_bridge.c" "${OVPN}/src/compat/compat-daemon.c"
  "${OVPN}/src/compat/compat-strsep.c")
add_executable(openvpn ${sources})
foreach(target IN ITEMS openvpn openvpn_compat)
  target_compile_definitions(${target} PRIVATE HAVE_CONFIG_H=1 TARGET_AMIGA=1 __NO_NET_API=1)
  target_compile_options(${target} PRIVATE -m68020 -O1 -include "${PROJECT_SOURCE_DIR}/cmake/ndk-compat.h"
    -Werror=implicit-function-declaration -Werror=int-conversion)
  target_include_directories(${target} PRIVATE "${CMAKE_BINARY_DIR}" "${OVPN}/include"
    "${OVPN}/src/compat" "${AMISSL_INCLUDE_DIR}")
endforeach()
target_link_options(openvpn PRIVATE -m68020)
target_link_libraries(openvpn PRIVATE openvpn_compat "${AMISSL_STUB_LIBRARY}")
