include(CheckIncludeFiles)
include(CheckSymbolExists)
include(CheckTypeSize)
include(CheckCSourceCompiles)
set(OVPN "${PROJECT_SOURCE_DIR}/src/openvpn")
set(CMAKE_REQUIRED_DEFINITIONS -D__NO_NET_API=1)
set(CMAKE_REQUIRED_FLAGS "-include \"${PROJECT_SOURCE_DIR}/cmake/ndk-compat.h\"")
foreach(header IN ITEMS arpa/inet.h fcntl.h inttypes.h libgen.h netdb.h
    netinet/in.h netinet/in_systm.h netinet/ip.h netinet/tcp.h net/if.h
    stdint.h stdlib.h stdio.h strings.h string.h grp.h pwd.h resolv.h syslog.h
    termios.h lzo1x.h sys/file.h sys/ioctl.h sys/param.h
    sys/select.h sys/socket.h sys/sockio.h sys/stat.h sys/time.h sys/types.h
    sys/uio.h sys/un.h sys/wait.h time.h unistd.h wchar.h)
  string(TOUPPER "HAVE_${header}" symbol)
  string(REGEX REPLACE "[^A-Z0-9_]" "_" symbol "${symbol}")
  check_include_files("sys/types.h;${header}" ${symbol})
endforeach()
foreach(function IN ITEMS access basename chdir dirname dup dup2 ftruncate
    gettimeofday readv writev strsep system vsnprintf)
  string(TOUPPER "HAVE_${function}" symbol)
  check_symbol_exists(${function} "sys/types.h;unistd.h;stdio.h;stdlib.h;string.h;libgen.h;sys/time.h;sys/uio.h" ${symbol})
endforeach()
if(NOT HAVE_GETTIMEOFDAY)
  set(AOVPN_BUNDLED_GETTIMEOFDAY 1)
  set(HAVE_GETTIMEOFDAY 1)
endif()
foreach(signal IN ITEMS SIGHUP SIGINT SIGTERM SIGUSR1 SIGUSR2)
  check_symbol_exists(${signal} signal.h HAVE_DECL_${signal})
endforeach()
check_type_size("unsigned int" SIZEOF_UNSIGNED_INT LANGUAGE C)
check_type_size("unsigned long" SIZEOF_UNSIGNED_LONG LANGUAGE C)
set(CMAKE_EXTRA_INCLUDE_FILES sys/types.h sys/socket.h sys/un.h)
check_type_size("sa_family_t" SA_FAMILY_T LANGUAGE C)
check_type_size("in_addr_t" IN_ADDR_T LANGUAGE C)
check_type_size("in_port_t" IN_PORT_T LANGUAGE C)
check_type_size("struct cmsghdr" CMSGHDR LANGUAGE C)
check_type_size("struct msghdr" MSGHDR LANGUAGE C)
unset(CMAKE_EXTRA_INCLUDE_FILES)
if(HAVE_SA_FAMILY_T)
  set(HAVE_SA_FAMILY_T 1)
endif()
